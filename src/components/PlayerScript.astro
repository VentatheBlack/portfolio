---
// One small global script for theme controls, lazy Vimeo players and image previews.
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    var themeButton = document.querySelector('[data-theme-toggle]');
    var systemTheme = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
    var savedTheme = '';
    try { savedTheme = localStorage.getItem('portfolio-theme') || ''; } catch (error) {}
    if (savedTheme === 'light' || savedTheme === 'dark') root.setAttribute('data-theme', savedTheme);

    function resolvedTheme() {
      var mode = root.getAttribute('data-theme') || 'auto';
      if (mode === 'auto') return systemTheme && systemTheme.matches ? 'dark' : 'light';
      return mode;
    }

    function updateThemeControl() {
      var mode = root.getAttribute('data-theme') || 'auto';
      var resolved = resolvedTheme();
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', resolved === 'dark' ? '#090909' : '#f4f3f1');
      if (!themeButton) return;
      var label = mode === 'auto'
        ? 'Theme follows system (' + resolved + '). Switch to ' + (resolved === 'dark' ? 'light' : 'dark') + ' mode'
        : mode.charAt(0).toUpperCase() + mode.slice(1) + ' mode selected. Return to system theme';
      themeButton.setAttribute('aria-label', label);
      themeButton.setAttribute('title', label);
      themeButton.setAttribute('aria-pressed', mode === 'auto' ? 'false' : 'true');
    }

    if (themeButton) {
      themeButton.addEventListener('click', function () {
        var mode = root.getAttribute('data-theme') || 'auto';
        if (mode === 'auto') {
          var next = resolvedTheme() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('portfolio-theme', next); } catch (error) {}
        } else {
          root.setAttribute('data-theme', 'auto');
          try { localStorage.removeItem('portfolio-theme'); } catch (error) {}
        }
        updateThemeControl();
      });
    }
    if (systemTheme) {
      var systemChanged = function () {
        if ((root.getAttribute('data-theme') || 'auto') === 'auto') updateThemeControl();
      };
      if (systemTheme.addEventListener) systemTheme.addEventListener('change', systemChanged);
      else if (systemTheme.addListener) systemTheme.addListener(systemChanged);
    }
    updateThemeControl();

    var dialog = document.getElementById('player');
    var box = dialog ? dialog.querySelector('.player-box') : null;
    var lastOpener = null;
    var warmed = false;

    function warmUp() {
      if (warmed) return;
      warmed = true;
      var link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = 'https://player.vimeo.com';
      document.head.appendChild(link);
    }

    function closest(event, attribute) {
      return event.target && event.target.closest ? event.target.closest('[' + attribute + ']') : null;
    }

    function makeFrame(element) {
      var id = element.getAttribute('data-vimeo-id');
      var hash = element.getAttribute('data-vimeo-hash');
      var frame = document.createElement('iframe');
      frame.src = 'https://player.vimeo.com/video/' + id + '?autoplay=1&playsinline=1&title=0&byline=0&portrait=0&dnt=1' + (hash ? '&h=' + hash : '');
      frame.title = element.getAttribute('data-title') || 'Video';
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      return frame;
    }

    document.addEventListener('pointerover', function (event) {
      if (closest(event, 'data-vimeo-id')) warmUp();
    }, { passive: true });
    document.addEventListener('touchstart', function (event) {
      if (closest(event, 'data-vimeo-id')) warmUp();
    }, { passive: true });

    document.addEventListener('click', function (event) {
      var inline = closest(event, 'data-inline');
      if (inline) {
        warmUp();
        var spot = document.createElement('div');
        spot.className = inline.className;
        spot.setAttribute('style', inline.getAttribute('style') || '');
        spot.appendChild(makeFrame(inline));
        inline.replaceWith(spot);
        return;
      }

      var opener = closest(event, 'data-play');
      if (opener && dialog && box) {
        event.preventDefault();
        warmUp();
        lastOpener = opener;
        box.innerHTML = '';
        box.style.setProperty('--r', opener.getAttribute('data-ratio') || '1.7778');
        box.appendChild(makeFrame(opener));
        if (dialog.showModal) dialog.showModal();
        else dialog.setAttribute('open', '');
        return;
      }

      var picture = closest(event, 'data-image');
      if (picture && dialog && box) {
        event.preventDefault();
        lastOpener = picture;
        box.innerHTML = '';
        box.style.setProperty('--r', picture.getAttribute('data-ratio') || '1.7778');
        var big = document.createElement('img');
        big.src = picture.getAttribute('data-image');
        big.alt = picture.getAttribute('data-title') || '';
        box.appendChild(big);
        if (dialog.showModal) dialog.showModal();
        else dialog.setAttribute('open', '');
        return;
      }

      if (dialog && (event.target === dialog || closest(event, 'data-close'))) dialog.close();
    });

    if (dialog) {
      dialog.addEventListener('close', function () {
        if (box) box.innerHTML = '';
        if (lastOpener && lastOpener.focus) lastOpener.focus();
        lastOpener = null;
      });
    }
  })();
</script>
